# Copie para .env: cp .env.example .env
#
# Credenciais alinhadas com docker-compose.yml (raiz do monorepo):
#   POSTGRES_USER=tripfinder
#   POSTGRES_PASSWORD=tripfinder_secret
#   POSTGRES_DB=tripfinder
#   container: seanb-postgres | porta host: 5433

DATABASE_URL="postgresql://tripfinder:tripfinder_secret@localhost:5433/tripfinder"

PORT=3333

# Auth (trocar em produção!)
JWT_SECRET=super-secret-change-in-production
